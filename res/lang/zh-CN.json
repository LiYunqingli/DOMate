            "opt": {
                "text": "等待页面中出现该文本",
                "gone": "反向等待：元素消失"
            },
            "examples": [
                "dom wait \"css=.result\" --timeout 10",
                "dom wait --text \"支付成功\"",
                "dom wait \"css=.loading\" --gone"
            ]
        },
        "click": {
            "brief": "点击元素",
            "desc": "滚动到元素可视区后派发完整的鼠标事件序列（pointerdown/mousedown/mouseup/click）。支持双击、右键、强制点击（绕过可见性检查）。注意：事件由脚本派发，isTrusted=false。",
            "opt": {
                "double": "双击",
                "right": "右键（contextmenu）",
                "force": "忽略可见性/遮挡检查，直接派发",
                "wait_nav": "点击后等待页面加载完成"
            },
            "examples": [
                "click \"text=登录\"",
                "click \"css=#submit\" --wait-nav",
                "click 3",
                "click \"css=.item\" --index 2 --double"
            ],
            "related": [
                "dom outline",
                "type"
            ]
        },
        "type": {
